# Copy to .env for local development. Every value below has a working default,
# so an empty .env boots against a local SQLite file with no setup.

# --- Turso (libSQL) -------------------------------------------------------
# Local: leave the file fallback. Production: libsql://<db>-<org>.turso.io
TURSO_DB_URL=file:./local.db
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io   # also accepted
TURSO_AUTH_TOKEN=
# Production refuses to boot on a local file unless this is explicitly true.
ALLOW_LOCAL_DB=true
# Drop a pre-rebuild schema on startup so the new tables can be created.
# Set false to make the app refuse to boot instead of dropping anything.
MIGRATE_LEGACY_SCHEMA=true

# --- server ---------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins, or * to allow the Eyesearch frontend from anywhere.
CORS_ORIGINS=*
# Absolute origin used in /opensearch.xml; falls back to the request host.
PUBLIC_BASE_URL=

# --- storage safety -------------------------------------------------------
STORAGE_PAGE_LIMIT=300000
# No single domain may hold more than this many indexed pages.
MAX_PAGES_PER_DOMAIN=10
STORAGE_COUNT_TTL_SECONDS=60

# --- Turso request shaping ------------------------------------------------
# 0.5 = two database requests per second, process-wide.
LIBSQL_MIN_INTERVAL_SECONDS=0.5

# --- crawl pipeline -------------------------------------------------------
CRAWLER_ENABLED=true
CRAWL_BATCH_SIZE=10
CRAWL_BATCH_SLEEP_SECONDS=2.0
CRAWL_EMPTY_BACKOFF_SECONDS=15.0
CRAWL_TIMEOUT_SECONDS=15.0
CRAWL_MAX_BODY_BYTES=512000
CRAWL_CONCURRENCY=5

# --- revalidation ---------------------------------------------------------
REVALIDATION_ENABLED=true
REVALIDATION_INTERVAL_SECONDS=3600
REVALIDATION_JITTER_SECONDS=30
REVALIDATION_BATCH_SIZE=5
REVALIDATION_STALE_AFTER_SECONDS=604800

# --- search ---------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_MAX_PAGE=20
