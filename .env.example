# Copy to .env for local development. Every value below has a working default,
# so an empty .env still boots against a local SQLite file.

# --- Turso (LibSQL) -------------------------------------------------------
# Local dev: leave as the file fallback. Production: libsql://<db>-<org>.turso.io
TURSO_DB_URL=file:./local.db
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io   # also accepted
TURSO_AUTH_TOKEN=

# --- server ---------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins, or * to allow the Eyesearch frontend from anywhere.
CORS_ORIGINS=*

# --- retrieval ------------------------------------------------------------
SEARCH_REGION=in-en
SAFESEARCH=moderate
DDGS_BUDGET_S=3.5
HTML_BUDGET_S=3.0
LITE_BUDGET_S=2.5
BING_BUDGET_S=3.0
CHAIN_BUDGET_S=7.0
MAX_CONCURRENT_LIVE=4
# Fourth fallback hop. Off by default: Bing's terms discourage automated
# scraping, so enabling it is the owner's call. DuckDuckGo hops stay on regardless.
ENABLE_BING_SCRAPE=false

# --- cache ----------------------------------------------------------------
CACHE_TTL_HOURS=24
CACHE_MIN_RESULTS=1

# --- contract -------------------------------------------------------------
DEFAULT_LIMIT=10
MAX_LIMIT=50
